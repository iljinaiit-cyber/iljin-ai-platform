{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "iljin-ai-works",
  "pages_build_output_dir": "./dist/pages",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "iljin-ai-works-db",
      "database_id": "<PROD_D1_ID>",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "iljin-ai-works-originals"
    }
  ],
  "vectorize": [
    {
      "binding": "VECTOR_INDEX",
      "index_name": "iljin-ai-works-vectors"
    }
  ],
  // Producer only. Pages Functions cannot consume queues, so the consumer lives
  // in the separate `indexer` Worker.
  "queues": {
    "producers": [
      {
        "binding": "INDEX_QUEUE",
        "queue": "iljin-index-jobs"
      }
    ]
  },
  "vars": {
    "LOCAL_LLM_MODEL": "gemma4:latest",
    "CLOUDFLARE_AI_MODEL": "@cf/zai-org/glm-5.2",
    "CLOUDFLARE_EMBED_MODEL": "@cf/baai/bge-m3",
    "CLOUDFLARE_RERANK_MODEL": "@cf/baai/bge-reranker-base",
    "CLOUDFLARE_TTS_MODEL": "@cf/myshell-ai/tts-ko",
    "CLOUDFLARE_IMAGE_MODEL": "@cf/black-forest-labs/flux-1-schnell",
    "LLM_TIMEOUT_MS": "60000",
    "LOCAL_LLM_TIMEOUT_MS": "90000",
    "DEFAULT_TENANT_ID": "iljin",
    "DEFAULT_DEPARTMENT": "DX전략팀",
    "DEFAULT_USER_ROLE": "user",
    "ALLOW_DEV_IDENTITY": "false",
    "ADMIN_EMAILS": "iljin.ai.it@gmail.com"
  }
}
