{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:pages": "npm run build && node scripts/prepare-cloudflare-pages.mjs",
    "deploy:pages": "npm run build:pages && wrangler pages deploy --branch main",
    "deploy:indexer": "wrangler deploy --config indexer/wrangler.jsonc",
    "deploy:all": "npm run deploy:pages && npm run deploy:indexer",
    "start": "vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/qa-scaffolds.test.mjs",
    "test:rag:g1": "node scripts/verify-g1.mjs --live",
    "test:rag:g2": "node scripts/verify-g2.mjs --live",
    "test:rag:smoke": "node scripts/verify-rag.mjs",
    "test:rag:golden": "node scripts/evaluate-rag.mjs",
    "test:access": "node scripts/verify-access-approval.mjs",
    "test:agent": "node scripts/verify-agent-tools.mjs",
    "qa:verify": "node scripts/verify-qa.mjs",
    "qa:verify:live": "node scripts/verify-qa.mjs --live",
    "qa:verify:strict": "node scripts/verify-qa.mjs --strict",
    "qa:security": "node scripts/verify-security-negative.mjs",
    "qa:security:live": "node scripts/verify-security-negative.mjs --live",
    "qa:browser": "node scripts/verify-browser-accessibility.mjs",
    "qa:dr": "node scripts/verify-dr-rehearsal.mjs",
    "qa:dr:strict": "node scripts/verify-dr-rehearsal.mjs --strict",
    "qa:load": "k6 run qa/load/k6-150-users.js",
    "capacity:calculate": "node scripts/calculate-capacity.mjs",
    "configure:production": "powershell -ExecutionPolicy Bypass -File scripts/configure-operating-environment.ps1",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern '**/.wrangler/**' --ignore-pattern outputs --ignore-pattern work",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.1",
    "wrangler": "4.120.0"
  },
  "type": "module"
}
