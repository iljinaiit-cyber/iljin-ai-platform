# Local development only. Copy to .env.local and fill secrets locally.
# Primary chat LLM: local OpenAI-compatible endpoint.
# vLLM example: http://127.0.0.1:8000
# Ollama example: http://127.0.0.1:11434
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=gemma4:latest
LOCAL_LLM_API_KEY=
# CPU inference can require a longer timeout. Allowed range: 5000-120000ms.
LOCAL_LLM_TIMEOUT_MS=90000
# Production Cloudflare Worker: use the protected Tunnel hostname and Access service token.
LOCAL_LLM_ACCESS_CLIENT_ID=
LOCAL_LLM_ACCESS_CLIENT_SECRET=

# Secondary chat LLM: Cloudflare AI binding or REST API.
# Must be an id listed by `wrangler ai models`. Default is GLM 5.2.
CLOUDFLARE_AI_MODEL=@cf/zai-org/glm-5.2
# Sites production uses REST credentials when an AI binding is unavailable.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional. Third-party models use the account default gateway when omitted.
CLOUDFLARE_AI_GATEWAY_ID=
# Primary RAG intelligence: Cloudflare Workers AI.
CLOUDFLARE_EMBED_MODEL=@cf/baai/bge-m3
CLOUDFLARE_RERANK_MODEL=@cf/baai/bge-reranker-base
CLOUD_VLM_MODEL=@cf/google/gemma-4-26b-a4b-it
# Multimodal output models (TTS + image generation)
CLOUDFLARE_TTS_MODEL=@cf/myshell-ai/tts-ko
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# Fallback embedding model, used only when no Cloudflare AI binding or REST
# credential is available. Internal search fails until the model is installed:
#   ollama pull nomic-embed-text
LOCAL_EMBED_MODEL=nomic-embed-text

# Internet search gateway. Default route:
# Tavily -> Exa -> Google -> Brave -> WebPilot -> DuckDuckGo (free) -> Jina AI (free) -> Wikimedia.
# Configured providers are queried in parallel batches (3 at a time) and merged
# for source diversity, not just sequential fallback. Change the order with a
# comma-separated provider list when required.
INTERNET_SEARCH_PROVIDER_ORDER=tavily,exa,google,brave,webpilot,duckduckgo,jina,wikimedia

# Tavily Search API: LLM-oriented raw content and relevance scores.
TAVILY_API_KEY=

# Exa Search API: embedding-based semantic search, a different candidate pool
# than keyword search. Get a key at https://exa.ai
EXA_API_KEY=

# Google Programmable Search / Custom Search JSON API.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Brave Search API.
BRAVE_SEARCH_API_KEY=

# Jina AI Reader + Search API (optional, increases free-tier rate limit).
# Without a key: limited rate. Get one at https://jina.ai/api/
JINA_API_KEY=

# Optional WebPilot-compatible adapter. Because WebPilot deployments can expose
# different contracts, configure only an approved endpoint that accepts
# POST {"query": "...", "limit": 8} and returns {"results": [...]}.
WEBPILOT_API_URL=
WEBPILOT_API_KEY=
LLM_TIMEOUT_MS=30000
DEFAULT_TENANT_ID=iljin
DEFAULT_DEPARTMENT=DX전략팀
DEFAULT_USER_ROLE=user
ALLOW_DEV_IDENTITY=false
ADMIN_EMAILS=
# One-time code required when an ADMIN_EMAILS account creates its first password.
ADMIN_BOOTSTRAP_TOKEN=
